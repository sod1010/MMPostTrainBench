# mmposttrainbench — configuration template.
#
# Copy this file to `config.env` (which is gitignored) and fill in the values
# for your environment. Every script under src/docker/ sources config.env; the
# Python tools read the exported vars from their process env. Values below are
# safe/relative PLACEHOLDERS — replace them with your real paths / ids / hosts.
# Secrets (tokens, keys) must live in files OUTSIDE the repo, referenced by path.

# ── core paths ────────────────────────────────────────────────
export REPO_ROOT=/path/to/mmposttrainbench          # this repo checkout
export MMPTB_ROOT=/path/to/mmptb_runs               # shared runtime root (models/data/workspaces/logs)
export MODEL=Qwen3-Omni-30B-A3B-Instruct            # model subdir name
export MODEL_DIR=$MMPTB_ROOT/models/$MODEL          # HF-format base-model dir (mounted at /models)
export DATA_DIR=$MMPTB_ROOT/data                    # eval data root (bench json + media)
export HF_CACHE_DIR=$MMPTB_ROOT/hf_cache            # HF_HOME hub cache (mounted at /hf_cache)

# Per-run directories: use a fresh pair for each model/run.
export WORKSPACE_HOST=$MMPTB_ROOT/workspaces/example_run
export LOGS_HOST=$MMPTB_ROOT/logs/example_run
export GPUS=all                                      # Docker --gpus selector

# ── HuggingFace download (prepare_data.sh) ────────────────────
export HF_ENDPOINT=https://hf-mirror.com            # HF mirror reachable from your network
export MODEL_REPO=Qwen/Qwen3-Omni-30B-A3B-Instruct  # open model repo to pull
export MMAU_REPO=lmms-lab-audio/mmau                # MMAU dataset repo
export HF_TOKEN_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/mmposttrainbench/hf_token"  # optional for open repos

# ── docker images (build_images.sh) ──────────────────────────
# All four images are PUBLIC-buildable (no internal registry); see train_omni/
# and eval_omni/ for the recipes.
export OMNI_EVAL_BASE=nvidia/cuda:12.8.0-cudnn-runtime-ubuntu22.04
export OMNI_EVAL_IMAGE=omni-eval:local
# Base for the omni-train image (train_omni/Dockerfile). Default = a PUBLIC
# ModelScope×SWIFT image that ships torch+TransformerEngine+apex+flash-attn+
# megatron-core prebuilt; override to a newer/closer tag from the ms-swift
# "Mirror" list if you like.
export OMNI_TRAIN_BASE=modelscope-registry.cn-hangzhou.cr.aliyuncs.com/modelscope-repo/modelscope:ubuntu22.04-cuda12.8.1-py311-torch2.10.0-vllm0.17.1-modelscope1.34.0-swift4.0.3
export OMNI_TRAIN_IMAGE=omni-train:local
export VERIFIER_IMAGE=mmptb-verifier:local
export AGENT_IMAGE=mmptb-agent:local
export TASK_DIR=$REPO_ROOT/harbor_tasks/mmposttrainbench-mmau-qwen3-omni-30b

# ── training (run_agent.sh → train_omni/run_sft_agent.sh) ─────
# The public megatron SFT entrypoint ships in the repo (train_omni/run_sft_agent.sh)
# and needs no external framework checkout — the omni-train image already has the
# ms-swift[megatron] stack installed. run_agent.sh points SFT_SCRIPT at it and runs
# it inside the agent container when the agent triggers training.
export SFT_SCRIPT=$REPO_ROOT/train_omni/run_sft_agent.sh
# SWIFT_DIR is OPTIONAL: set it only if you want to bind an external ms-swift
# checkout read-only into the training container (e.g. to run a patched framework).
# Leave it UNSET to use the ms-swift installed in the omni-train image.
# export SWIFT_DIR=/path/to/ms-swift
# TRAIN_DATASET is intentionally NOT defaulted: the agent must build its own
# dataset inside the workspace and pass it explicitly.

# ── eval env (bench_recipes.sh) ───────────────────────────────
export OMNI_PY=/path/to/omni_env/bin/python         # python for the omni-eval env
export LMMS_PY=/path/to/lmms_env/bin/python         # python for the lmms-eval env
export CABUNDLE=                                     # optional operator-approved CA bundle for HTTPS
export FFMPEG_SHIM=                                  # optional ffmpeg shim libdir
export OMNI_LIB=                                     # optional extra libdir for the omni env
export OVB_DATA=$DATA_DIR/OmniVideoBench_local/data.json
export OVB_VIDEO_DIR=$DATA_DIR/OmniVideoBench/videos_local
export EVAL_BENCH_DIR=$DATA_DIR/evaluationbench      # holds JointAVBench/ and OmniVideoBench_local/ (build_contam_reference.py)
# export JOINTAV_DATA=$EVAL_BENCH_DIR/JointAVBench/jointavbench.json
# export JOINTAV_MEDIA_ROOT=$EVAL_BENCH_DIR/JointAVBench
export VIDEOMME_V2_VIDEO_DIR=$HF_CACHE_DIR/videomme_v2_videos   # 800 source .mp4 (prepare_data.sh extracts here)
# Per-bench HF repo overrides (default to resources.json); e.g. point at a mirror/fork:
# export JOINTAVBENCH_REPO=roverx12345/jointavbench
# export OMNIVIDEOBENCH_REPO=NJU-LINK/OmniVideoBench

# ── mmswe / SWE-bench Multimodal (the code bench; real resolved rate) ──
# Grading runs the instance's official container image WITHOUT a docker daemon
# (src/eval/tasks/mmswe/dlc_native_grade.py): registry-v2 manifest for the trust
# anchor, blob bytes from a mirror, every blob sha256-verified, rootfs unpacked to
# /dev/shm, then unshare+chroot. It therefore needs its own python env (swebench)
# and outbound HTTPS to the registry, the mirror and each instance's screenshots.
export SWE_WORK=$DATA_DIR/mmptb_swe                  # holds venv/ + blob_cache/
export SWE_VENV_PY=$SWE_WORK/venv/bin/python         # python with swebench==5.0.2
export SWE_HF_CACHE=$HF_CACHE_DIR                    # HF cache holding the SWE dataset
export SWE_DATASET=SWE-bench/SWE-bench_Multimodal
# Dataset split is derived from EVAL_SPLIT: val -> dev, eval -> test.
# Leave SWE_SPLIT / MMSWE_SPLIT unset; explicit mismatched values are rejected.
# export SWE_SPLIT=test                              # optional matching override
# export SWE_GRADE_TIMEOUT=1800                      # per-instance test-run timeout (s)
# export MMSWE_BLOB_CACHE=$SWE_WORK/blob_cache       # "" disables (re-pulls every run)
# export MMSWE_REGISTRY_API=https://registry-1.docker.io    # digests / trust anchor
# export MMSWE_BLOB_MIRROR=https://docker.1panel.live       # bytes only; sha256-verified
# export MMSWE_PULL_BUDGET=3600                      # per-instance cold-pull deadline (s)
# export MMSWE_USE_IMAGES=1                          # feed problem screenshots to the model
# export MMSWE_MAX_IMAGES=4
# export MMSWE_MAX_NEW_TOKENS=3072

# ── execution-side isolation (container boundary) ─────────────
# There is no host-filesystem mask to configure: run_agent.sh / run_loop.sh run
# the agent (and the training it triggers) inside a container that mounts ONLY the
# workspace, the read-only base model, a clean HF cache and an optional read-only
# train_data dir. The operator's filesystem — prior workspaces, the eval DATA_DIR,
# the verifier's HF_CACHE_DIR — is never bind-mounted in, so it is simply absent
# from the agent's view. If you scale training out to your own scheduler, give each
# job the SAME minimal mount set and nothing else (see src/docker/README.md
# "Isolation contract").

# ── anti-cheat LLM judge (judge.py) ───────────────────────────
export JUDGE_KEYFILE="${XDG_CONFIG_HOME:-$HOME/.config}/mmposttrainbench/judge_key"  # operator-private file
export JUDGE_PROTOCOL=openai                        # openai (Responses) | anthropic (messages)
export JUDGE_BASE_URL=https://your-llm-gateway.example.com/protocol/openai
# export JUDGE_BASE_OPENAI=https://your-llm-gateway.example.com/protocol/openai
# export JUDGE_BASE_ANTHROPIC=https://your-llm-gateway.example.com/protocol/anthropic
export JUDGE_MODEL=gpt-5.5                           # judge model id (keep different from the agent's model)

# --- agent model / endpoint (optional) ---------------------------------------
# Which vendor CLI drives the loop, and which model it talks to. AGENT_MODEL is
# a plain model id passed straight to the CLI (--model / -m). Leave it unset to
# use the CLI's own default.
#   AGENT_ENGINE=claude-code AGENT_MODEL=claude-opus-4-5
#   AGENT_ENGINE=codex       AGENT_MODEL=gpt-5.1
#   AGENT_ENGINE=gemini      AGENT_MODEL=gemini-2.5-pro
# AGENT_ENGINE=placeholder
# AGENT_MODEL=
#
# To run a gateway-fronted or SELF-HOSTED model as the agent, point the base URL
# at it (Anthropic protocol -> ANTHROPIC_*, OpenAI protocol -> OPENAI_*). A local
# vLLM/SGLang server behind an Anthropic-compatible shim works:
# ANTHROPIC_BASE_URL=http://127.0.0.1:18090
# ANTHROPIC_AUTH_TOKEN=dummy
# ANTHROPIC_MODEL=my-local-model
# OPENAI_BASE_URL=http://127.0.0.1:8000/v1
#
# NOTE keep the agent model DIFFERENT from the judge model (JUDGE_* below):
# a model judging its own trajectory is not an independent check.
